# Postgres connection string. On Vercel this is provided automatically by the
# Neon integration; locally, copy this file to .env.local and paste the same
# value (Vercel → Storage → your database → .env.local snippet).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Claude API key, used by the contract upload feature to read a signed
# agreement and propose a project. Create one at console.anthropic.com and add
# the same value in Vercel → Settings → Environment Variables. Without it the
# rest of the portal works and only the upload button reports an error.
ANTHROPIC_API_KEY=sk-ant-...

# Email notifications. Mail goes through a Google Workspace mailbox: SMTP_USER is
# its address, SMTP_PASS an app password for it. Set these in Vercel only, not in
# .env.local, because local development shares the production database. With no
# SMTP_PASS nothing is sent.
SMTP_USER=
SMTP_PASS=
# Optional: a different From address (must be an alias of SMTP_USER).
MAIL_FROM=
# Optional: while set, all mail goes to this address and nothing is recorded.
MAIL_TEST_TO=
# Protects /api/cron/notifications. Any long random string; Vercel Cron sends it.
CRON_SECRET=
